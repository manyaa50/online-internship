# Application Secret Key (Mandatory in production / non-debug mode)
SECRET_KEY=smart-internship-scam-prevention-secret-key-2026-bca

# Flask Debug Mode (defaults to false if omitted)
FLASK_DEBUG=false

# Rate Limiter Settings (defaults to memory:// storage)
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# MySQL Database Configuration (Defaults configured for XAMPP / WAMP)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_internship_db

# Optional direct database connection string (e.g., MySQL or SQLite fallback)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/smart_internship_db
# DATABASE_URL=sqlite:///smart_internship.db
